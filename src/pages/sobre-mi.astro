---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Contact from '../components/Contact.astro';
import { about } from '../data/about';
import { links } from '../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const total = String(about.timeline.length).padStart(2, '0');
const now = about.now.filter((item) => item.value.trim() !== '');
---

<Base
  title="Detrás de la cámara · Sara Ardila"
  description="Quién es Sara Ardila: de la fotografía y el diseño al desarrollo Android con Kotlin y Jetpack Compose."
>
  <!-- 1. Presentación -->
  <div class="bg-grid">
    <section class="wrap hero">
      <div class="hero__text">
        <p class="tag">Sobre mí</p>
        <h1 class="h1">Detrás <span class="hero__hand">de la cámara.</span></h1>
        {about.intro.map((paragraph) => <p class="lead">{paragraph}</p>)}
        {
          links.cv && (
            <div class="btn-row">
              <a class="btn" href={`${base}${links.cv}`} download>
                Descargar CV
              </a>
            </div>
          )
        }
        <p class="scroll-cue" aria-hidden="true">baja y pasa el carrete ↓</p>
      </div>

      <div class="selfie develop">
        <div class="pin" aria-hidden="true"></div>
        <div class="polaroid selfie__card">
          <div class="selfie__photo">
            {
              about.photo ? (
                <img src={`${base}${about.photo}`} alt="Sara Ardila" />
              ) : (
                <span class="phone__pending">tu foto aquí</span>
              )
            }
            {about.photo && <div class="veil" aria-hidden="true" />}
          </div>
          <p class="polaroid__caption">autorretrato</p>
        </div>
      </div>
    </section>
  </div>

  <!-- 2. El carrete: trayectoria con scroll horizontal, de lo más reciente a lo más antiguo -->
  <section class="reel" aria-labelledby="carrete">
    <div class="reel__pin">
      <div class="wrap reel__head">
        <div>
          <h2 id="carrete" class="h2">El carrete, <span class="hand">rebobinado.</span></h2>
          <p class="reel__sub">De lo último a donde empezó todo.</p>
        </div>
        <p class="reel__counter label" aria-hidden="true">
          Foto <span data-counter>01</span> / {total}
        </p>
      </div>

      <nav class="wrap reel__nav" aria-label="Ir a cada etapa">
        {
          about.timeline.map((m, i) => (
            <button class="chip" type="button" data-go={i} aria-current={i === 0 ? 'true' : undefined}>
              {m.short}
            </button>
          ))
        }
      </nav>

      <div class="reel__strip">
        <div class="reel__roll">
          <div class="film" aria-hidden="true"></div>
          <ol class="reel__track">
        {
          about.timeline.map((m, i) => (
            <li class={`frame frame--${m.tone}${m.current ? ' frame--current' : ''}`} data-frame={i}>
              <p class="frame__num">
                {String(i + 1).padStart(2, '0')}A · {m.kind}
              </p>
              <p class="frame__year">{m.period}</p>
              <h3 class="frame__title">{m.role}</h3>
              {m.place && <p class="frame__place">{m.place}</p>}
              <p class="frame__text">{m.text}</p>
              {m.current && <span class="frame__here" aria-hidden="true">lo último</span>}
            </li>
          ))
        }
      </ol>
          <div class="film" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Fuera de cámara: aficiones que se giran -->
  <section class="bg-stripes section" aria-labelledby="fuera">
    <div class="wrap">
      <h2 id="fuera" class="h2 h2--label reveal">Fuera <span class="hand">de cámara.</span></h2>
      <p class="hand-note off__hint">toca una foto para darle la vuelta</p>
    </div>

    <svg class="rope" aria-hidden="true" viewBox="0 0 1000 60" preserveAspectRatio="none">
      <path d="M0 6 Q500 64 1000 6" fill="none" stroke="currentColor" stroke-width="3" vector-effect="non-scaling-stroke"></path>
    </svg>

    <ul class="wrap line off">
      {
        about.offCamera.map((item) => (
          <li class="hang hang--sm">
            <div class="pin" aria-hidden="true" />
            <button class="flip" type="button" aria-pressed="false">
              <span class="flip__inner">
                <span class="flip__face">
                  <Icon name={item.icon} />
                  <span class="flip__word">{item.word}</span>
                </span>
                <span class="flip__face flip__back">
                  <span>{item.back}</span>
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 4. Ahora mismo -->
  <section class="section" aria-labelledby="ahora">
    <div class="wrap stack-col">
      <h2 id="ahora" class="h2 reveal">
        <span class="rec" aria-hidden="true"></span>Ahora <span class="hand">mismo.</span>
      </h2>
      <dl class="now">
        {
          now.map((item, i) => (
            <div class="now__item reveal" style={`--r: ${i % 2 ? '1.5deg' : '-1.5deg'}`}>
              <dt class="label">{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 5. Contacto -->
  <Contact />
</Base>

<script>
  // Dar la vuelta a las fotos de "Fuera de cámara"
  document.querySelectorAll<HTMLButtonElement>('.flip').forEach((button) => {
    button.addEventListener('click', () => {
      const pressed = button.getAttribute('aria-pressed') === 'true';
      button.setAttribute('aria-pressed', String(!pressed));
    });
  });

  // El carrete: en escritorio se queda fijo y avanza en horizontal con el scroll.
  // En móvil o con "reducir movimiento" es una tira normal que se desliza con el dedo.
  // Los botones de años llevan directamente a cada fotograma.
  const reel = document.querySelector<HTMLElement>('.reel');
  if (reel) {
    const strip = reel.querySelector<HTMLElement>('.reel__strip')!;
    const roll = reel.querySelector<HTMLElement>('.reel__roll')!;
    const track = reel.querySelector<HTMLElement>('.reel__track')!;
    const counter = reel.querySelector<HTMLElement>('[data-counter]')!;
    const frames = Array.from(track.querySelectorAll<HTMLElement>('.frame'));
    const chips = Array.from(reel.querySelectorAll<HTMLButtonElement>('[data-go]'));
    const wide = window.matchMedia('(min-width: 721px) and (prefers-reduced-motion: no-preference)');
    const smooth: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    let distance = 0;
    let ticking = false;
    let current = -1;

    const pinned = () => reel.classList.contains('reel--pinned');

    // Desplazamiento del carrete que deja el fotograma i centrado en pantalla
    const offsetFor = (i: number) => {
      const frame = frames[i];
      const target = frame.offsetLeft + frame.offsetWidth / 2 - strip.clientWidth / 2;
      return Math.min(distance, Math.max(0, target));
    };

    const setActive = (index: number) => {
      if (index === current) return;
      current = index;
      counter.textContent = String(index + 1).padStart(2, '0');
      chips.forEach((chip, i) => {
        if (i === index) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      });
      if (pinned()) frames.forEach((frame, i) => frame.classList.toggle('is-developed', i <= index));
    };

    // El fotograma activo es el que queda más cerca del centro
    const nearest = (offset: number) => {
      const center = offset + strip.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      frames.forEach((frame, i) => {
        const d = Math.abs(frame.offsetLeft + frame.offsetWidth / 2 - center);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      return best;
    };

    const update = () => {
      ticking = false;
      if (pinned()) {
        if (distance <= 0) return;
        const progress = Math.min(1, Math.max(0, -reel.getBoundingClientRect().top / distance));
        const offset = progress * distance;
        roll.style.transform = `translate3d(${-offset}px, 0, 0)`;
        setActive(nearest(offset));
      } else {
        setActive(nearest(strip.scrollLeft));
      }
    };

    const requestUpdate = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const go = (i: number) => {
      if (pinned()) {
        const reelTop = reel.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top: reelTop + offsetFor(i), behavior: smooth });
      } else {
        strip.scrollTo({ left: offsetFor(i), behavior: smooth });
      }
    };

    chips.forEach((chip) => chip.addEventListener('click', () => go(Number(chip.dataset.go))));
    frames.forEach((frame, i) => frame.addEventListener('click', () => go(i)));

    const layout = () => {
      roll.style.transform = '';
      if (!wide.matches) {
        reel.classList.remove('reel--pinned');
        reel.style.height = '';
        distance = Math.max(0, strip.scrollWidth - strip.clientWidth);
        frames.forEach((frame) => frame.classList.add('is-developed'));
      } else {
        reel.classList.add('reel--pinned');
        distance = Math.max(0, roll.scrollWidth - strip.clientWidth);
        reel.style.height = `${distance + window.innerHeight}px`;
      }
      current = -1;
      update();
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    strip.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', layout);
    wide.addEventListener('change', layout);
    layout();
  }
</script>
