---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import Contact from '../components/Contact.astro';
import { projects, upcoming, links } from '../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const strengths = [
  {
    icon: 'code',
    title: 'Código que se mantiene',
    text: 'Arquitectura por capas para que la app crezca sin romperse.',
    tags: ['Clean Architecture', 'MVVM', 'Hilt'],
  },
  {
    icon: 'phone',
    title: 'Interfaces que se sienten bien',
    text: 'Ojo de diseñadora: espaciado, animaciones y detalle visual.',
    tags: ['Jetpack Compose', 'Material 3', 'Figma'],
  },
  {
    icon: 'team',
    title: 'Equipo, no solo código',
    text: 'Me entiendo con diseño, backend y QA desde el primer día.',
    tags: ['Scrum', 'Code review', 'Git'],
  },
];
const tilts = ['-2deg', '1.5deg', '-1deg'];
---

<Base
  title="Sara Ardila · Android Developer"
  description="Portfolio de Sara Ardila, Android Developer en Madrid. Apps con Kotlin y Jetpack Compose que se sienten tan bien como se ven."
>
  <div class="bg-grid">
    <section class="wrap hero">
      <div class="hero__text">
        <p class="tag">Android Developer · Kotlin · Compose</p>
        <h1 class="h1">De la cámara <span class="hero__hand">al código.</span></h1>
        <p class="lead">
          Soy Sara. Antes encuadraba fotos; ahora revelo apps Android que se sienten tan bien como se ven.
        </p>
        <div class="btn-row">
          <a class="btn" href="#proyectos">Ver lo revelado</a>
          <a class="btn btn--ghost" href={links.github}>GitHub</a>
        </div>
      </div>

      <div class="stack">
        <div class="polaroid fan fan--l" aria-hidden="true">
          <div class="swatch" style="background: var(--soft)"></div>
        </div>
        <div class="polaroid fan fan--r" aria-hidden="true">
          <div class="swatch" style="background: var(--sky)"></div>
        </div>
        <div class="polaroid develop">
          <div class="hero-photo">
            <img src={`${base}/img/sara.jpg`} alt="Sara Ardila" />
            <div class="veil" aria-hidden="true"></div>
          </div>
          <p class="polaroid__caption">hola, soy Sara</p>
        </div>
      </div>
    </section>
  </div>

  <section id="aporto" class="bg-stripes section">
    <div class="wrap stack-col">
      <h2 class="h2 h2--label reveal">Qué <span class="hand">aporto.</span></h2>
      <div class="cards">
        {
          strengths.map((item, i) => (
            <div class="reveal">
              <div class="note strength" style={`--r: ${tilts[i]}`}>
                <svg
                  class="strength__icon"
                  aria-hidden="true"
                  viewBox="0 0 48 48"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  {item.icon === 'code' && <path d="M17 14 L7 24 L17 34 M31 14 L41 24 L31 34 M27 10 L21 38" />}
                  {item.icon === 'phone' && (
                    <>
                      <rect x="14" y="5" width="20" height="38" rx="4" />
                      <circle cx="24" cy="20" r="6" />
                      <path d="M21 37h6" />
                    </>
                  )}
                  {item.icon === 'team' && (
                    <>
                      <circle cx="16" cy="17" r="6" />
                      <circle cx="32" cy="17" r="6" />
                      <path d="M5 40c1-7 6-11 11-11s10 4 11 11M21 40c1-7 6-11 11-11s10 4 11 11" />
                    </>
                  )}
                </svg>
                <h3 class="strength__title">{item.title}</h3>
                <p>{item.text}</p>
                <ul class="strength__tags">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="proyectos" class="section" style="padding-bottom: 112px">
    <div class="wrap">
      <h2 class="h2 reveal">Secándose <span class="hand">en la cuerda.</span></h2>
    </div>

    <svg class="rope" aria-hidden="true" viewBox="0 0 1000 60" preserveAspectRatio="none">
      <path d="M0 6 Q500 64 1000 6" fill="none" stroke="currentColor" stroke-width="3" vector-effect="non-scaling-stroke"></path>
    </svg>

    <div class="wrap line">
      {
        projects.map((project) => (
          <article class="hang develop">
            <div class="pin" aria-hidden="true" />
            <div class="hang__card">
              <div class="hang__photo" style={`background: var(--${project.tone})`}>
                <Phone src={project.cover} alt={`Captura de ${project.name}`} />
              </div>
              <h3 class="hang__title">{project.name}</h3>
              <p class="small">
                {project.short} {project.stackShort}
              </p>
              <a class="btn" href={`${base}/proyectos/${project.slug}/`}>
                Ver la foto entera<span class="sr-only"> de {project.name}</span>
              </a>
            </div>
            {project.featured && (
              <>
                <div class="circle" aria-hidden="true" />
                <p class="best" aria-hidden="true">esta, la buena</p>
              </>
            )}
          </article>
        ))
      }

      <article class="hang">
        <div class="pin" aria-hidden="true"></div>
        <div class="hang__card">
          <div class="pending">revelándose…</div>
          <h3 class="hang__title">{upcoming.title}</h3>
          <p class="small">{upcoming.text}</p>
        </div>
      </article>
    </div>
  </section>

  <section id="conoceme" class="bg-ink section">
    <div class="wrap split reveal">
      <div class="split__main">
        <h2 class="h2">Detrás de <span class="hand" style="color: var(--soft)">la cámara.</span></h2>
        <p style="max-width: 34rem">De la fotografía al desarrollo Android: mi trayectoria y lo que hago fuera de cámara.</p>
      </div>
      <div class="btn-row" style="flex: 1 1 220px">
        <a class="btn" href={`${base}/sobre-mi/`}>Conóceme →</a>
        {links.cv && <a class="btn btn--ghost" href={`${base}${links.cv}`} download>Descargar CV</a>}
      </div>
    </div>
  </section>

  <Contact />
</Base>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
