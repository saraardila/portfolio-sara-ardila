---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Esta foto se veló · Sara Ardila" description="La página que buscas no existe.">
  <div class="bg-grid">
    <section class="wrap hero" style="min-height: 60vh">
      <div class="hero__text">
        <p class="tag">Error 404</p>
        <h1 class="h1">Esta foto <span class="hero__hand">se veló.</span></h1>
        <p class="lead">La página que buscas no existe o ha cambiado de sitio. Las buenas siguen colgadas en la cuerda.</p>
        <div class="btn-row">
          <a class="btn" href={`${base}/`}>Volver al inicio</a>
          <a class="btn btn--ghost" href={`${base}/#proyectos`}>Ver proyectos</a>
        </div>
      </div>
      <div class="stack">
        <div class="polaroid" style="rotate: 5deg">
          <div class="swatch" style="background: #2a1a1c"></div>
          <p class="polaroid__caption">velada</p>
        </div>
      </div>
    </section>
  </div>
</Base>
