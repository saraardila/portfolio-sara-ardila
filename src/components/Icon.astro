---
// Iconos de línea para "Fuera de cámara"
interface Props {
  name: 'book' | 'pilates' | 'camera' | 'plane' | 'paw';
}

const { name } = Astro.props;
---

<svg
  class="icon"
  aria-hidden="true"
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'book' && (
      <>
        <path d="M32 18c-6-4-14-5-22-4v34c8-1 16 0 22 4 6-4 14-5 22-4V14c-8-1-16 0-22 4z" />
        <path d="M32 18v34" />
      </>
    )
  }
  {
    name === 'pilates' && (
      <>
        <circle cx="32" cy="32" r="20" />
        <circle cx="32" cy="32" r="14" />
        <path d="M12 32h-4M56 32h-4" />
      </>
    )
  }
  {
    name === 'camera' && (
      <>
        <rect x="8" y="20" width="48" height="32" rx="5" />
        <path d="M22 20l4-6h12l4 6" />
        <circle cx="32" cy="36" r="9" />
        <circle cx="48" cy="27" r="1.5" fill="currentColor" />
      </>
    )
  }
  {
    name === 'plane' && (
      <>
        <path d="M8 36l48-20-14 36-9-13z" />
        <path d="M33 39l23-23" />
      </>
    )
  }
  {
    name === 'paw' && (
      <>
        <path d="M32 34c-8 0-14 8-14 13 0 4 3 6 7 6 3 0 5-2 7-2s4 2 7 2c4 0 7-2 7-6 0-5-6-13-14-13z" />
        <ellipse cx="20" cy="26" rx="4" ry="5.5" />
        <ellipse cx="28" cy="18" rx="4" ry="5.5" />
        <ellipse cx="36" cy="18" rx="4" ry="5.5" />
        <ellipse cx="44" cy="26" rx="4" ry="5.5" />
      </>
    )
  }
</svg>
